[Unit]
Description=Content Bot VOD hang detector tick (oneshot heal)
After=network-online.target content-bot-vod-feed.service
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
EnvironmentFile=-/root/.video_bot.env
# Drought soften overlay — load AFTER steady pins (same as feed unit).
EnvironmentFile=-/root/.video_bot.drought.env
Environment=CONTENT_BOT_REPO=/root/content_bot_ml
Environment=PYTHONPATH=/root/content_bot_ml/scripts:/usr/local/bin
Environment=VOD_FEED_ALLOW_NOHUP=0
ExecStart=/usr/bin/python3 -u /usr/local/bin/vod_hang_detector.py --tick --game pubg
WorkingDirectory=/root/content_bot_ml
