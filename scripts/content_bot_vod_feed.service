[Unit]
Description=Content Bot PUBG/MLBB VOD feed (systemd-owned)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Single owner: only this unit may run the supervisor. Do not start
# mlbb_vod_segment_feed.sh from cron, nohup, or a second systemd unit.
ExecStart=/usr/local/bin/mlbb_vod_segment_feed.sh
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=20
KillMode=control-group
TimeoutStopSec=45
Environment=CONTENT_BOT_REPO=/root/content_bot_ml

[Install]
WantedBy=multi-user.target
