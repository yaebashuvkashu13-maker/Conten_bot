# MLBB content farm — copy to /root/.video_bot.env and fill secrets

# Telegram
TG_BOT_TOKEN=
TG_CHAT_ID=

# Paths
CONTENT_BOT_REPO=/root/content_bot_ml
MLBB_DATA_ROOT=/root/data/mlbb
MLBB_VOD_INBOX=/root/data/mlbb/youtube_nightly/inbox
MLBB_VOD_SEGMENTS_ROOT=/root/datasets/mlbb/vod_segments
MLBB_TRAINING_ARCHIVE_ROOT=/root/datasets/mlbb/training_archive
MLBB_TRAINING_ARCHIVE=1
MLBB_SHORTS_MIN_DURATION_SEC=3
MLBB_SHORTS_MAX_DURATION_SEC=1200
MLBB_SHORTS_SHORT_MAX_SEC=60
MLBB_SHORTS_INCLUDE_VIDEOS_TAB=1
MLBB_SHORTS_DOWNLOAD_TIMEOUT_SEC=900
MLBB_CALIB_SCAN_MIN_SEC=20
MLBB_CALIB_SCAN_STEP_SEC=25
MLBB_SHORTS_MIN_UPLOAD_DATE=20260101
MLBB_SHORTS_INGEST_DAYS=365

# Worker
MLBB_SEND_ENABLED=1
MLBB_TARGET_PENDING=40
MLBB_CONTINUOUS_LOOP_SEC=4
MLBB_FEED_COOLDOWN_SEC=300
MLBB_INGEST_COOLDOWN_SEC=180
MLBB_WORKER_STALE_SEC=1800
MLBB_CALIBRATION_BATCH=4
MLBB_PRUNE_PENDING_LIMIT=15
MLBB_PRUNE_MAX_SEC=60
MLBB_INDEX_REPAIR_SEC=90
MLBB_INDEX_REBUILD_SEC=120
MLBB_FEED_TRY_INGEST=0
MLBB_SEARCH_BEFORE_STREAMERS=1
MLBB_OWNER_CHANNELS_LAST=1
MLBB_OWNER_CHANNEL_LIMIT=2
MLBB_INGEST_FULL_SWEEP_PENDING=8
MLBB_INGEST_MAX_RUN_SEC=2400
MLBB_VOD_COOLDOWN_SEC=300
MLBB_CALIBRATION_LENIENT=1
MLBB_CALIBRATION_MIN_SEND_SCORE=0
# Identity gate (always on — blocks wrong-game Shorts even in lenient mode)
MLBB_IDENTITY_MIN_MINIMAP_PRESENCE=0.55
MLBB_IDENTITY_MIN_MOTION=0.012
MLBB_IDENTITY_MIN_HUD_DELTA=0.004
MLBB_ACTIVITY_MIN_MOTION=0.018
MLBB_ACTIVITY_MIN_HUD_DELTA=0.0045
MLBB_SHORTS_MAX_MUSIC_BED=0.42
MLBB_GAMEPLAY_MIN_MOTION=0.020
MLBB_GAMEPLAY_MIN_HUD_DELTA=0.005
MLBB_GAMEPLAY_MIN_MINIMAP_PRES=0.68
MLBB_SHORTS_MIN_GAMEPLAY_HEURISTIC=0.78
MLBB_SHORTS_STREAMER_ONLY=0
MLBB_SHORTS_SEARCH_FALLBACK=1
MLBB_SHORTS_MIN_POOL=8
MLBB_STREAMER_REQUIRE_MLBB_TITLE=1
MLBB_SHORTS_STRICT_VERIFY=1
MLBB_SHORTS_REQUIRE_KILL_UI=1
MLBB_SHORTS_MIN_COMBINED=0.14
MLBB_SHORTS_MIN_COMBINED_NO_KILL=0.22
MLBB_SHORTS_MAX_REJECT_SIM=0.72
MLBB_SHORTS_MIN_CLIP_SCORE=0.03
MLBB_VERIFY_MIN_MINIMAP=0.011
MLBB_SHORTS_TRIM_OPENING=1
MLBB_SHORTS_MAX_OPENING_SKIP=7.5
MLBB_SHORTS_MIN_TRIM_SEND=0.35
MLBB_CALIBRATION_TRIM_DIR=/root/data/mlbb/calibration_trimmed
MLBB_MAX_DAILY_SENDS=500

# VOD selection (reliable streams only)
MLBB_VOD_MIN_SEC=600
MLBB_VOD_MAX_SEC=2700
MLBB_FORCE_MAX_LIVE_VOD_SEC=2700
MLBB_FORCE_MAX_LIVE_VOD_FPS=55
MLBB_VOD_TARGET_DUR_SEC=1500
MLBB_VOD_SLICE_MIN=90
MLBB_VOD_SLICE_MAX_VODS=8
MLBB_VOD_PROBE_LIMIT=40
MLBB_VOD_BATCH_MAX=40

# Clip quality
MLBB_VOD_KILL_FIRST=1
MLBB_VOD_VARIABLE_LENGTH=1
MLBB_VOD_LEAD_SEC=4
MLBB_FIGHT_MIN_SEC=7
MLBB_FIGHT_MAX_SEC=22
MLBB_VOD_FULL_FRAME=1
SMART_CROP_WEBCAM=0
MLBB_REQUIRE_KILL_UI=1
MLBB_VOD_SEGMENT_GAP_SEC=45
MLBB_VOD_MIN_PEAK_SEC=420

# Render / presend
MLBB_VOD_CHUNK_RENDER=1
MLBB_CHUNK_COARSE_PAD=10
MLBB_PRESEND_FREEZE_MIN_DUR=1.2
MLBB_PRESEND_FREEZE_MAX_START=3.0
MLBB_FORCE_RERENDER=1

# Kill UI scan
MLBB_KILL_SCAN_STEP_SEC=45
MLBB_KILL_SCAN_LIMIT=48
MLBB_KILL_UI_MIN_SCORE=0.14
