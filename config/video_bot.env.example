# Copy to /root/.video_bot.env on the VPS and fill secrets.
# NEVER commit the real file — it contains tokens.
#
#   cp config/video_bot.env.example /root/.video_bot.env
#   chmod 600 /root/.video_bot.env
#   nano /root/.video_bot.env

# --- Required (Telegram) ---
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Repo path on VPS ---
CONTENT_BOT_REPO=/root/content_bot_ml

# --- MLBB VOD-only mode (set by install_mlbb_vod_only.sh; listed here for reference) ---
MLBB_ONLY_MODE=1
MLBB_VOD_ONLY=1
MLBB_VOD_DISABLED=0
MLBB_CALIBRATION_FEED_ENABLED=0
MLBB_SEND_ENABLED=1

# --- Banner / kill detection (productive VOD defaults) ---
MLBB_VOD_KILL_BANNER=1
MLBB_KILL_BANNER_REQUIRED=0
MLBB_KILL_BANNER_MIN_TIER=double
MLBB_KILL_BANNER_SCAN_BEFORE=20
MLBB_KILL_BANNER_SCAN_AFTER=10
MLBB_VOD_BANNER_PREFILTER=0
MLBB_VOD_BANNER_PREFILTER_PEAKS=8
MLBB_VOD_BANNER_DISCOVER=0
MLBB_VOD_BANNER_PRESEND=0
MLBB_VOD_MOTION_ANCHOR_OK=1
MLBB_VOD_LENIENT_UNIFORM=1

MLBB_VOD_SEND_ONE=1
MLBB_VOD_SEGMENT_GAP_SEC=120
MLBB_VOD_MIN_PEAK_SEC=300
MLBB_VOD_SEGMENT_SEC=15
MLBB_VOD_MIN_SEC=180
MLBB_VOD_MAX_SEC=1200
MLBB_VOD_TARGET_DUR_SEC=780

# --- Exemplars / learning ---
HIGHLIGHT_EXEMPLAR_ROOT=/root/content_bot_ml/data/highlight_exemplars
MLBB_VOD_OWNER_EXEMPLARS=1
HIGHLIGHT_USE_OWNER_ANCHORS=0
MLBB_CALIBRATION_LABELS=/root/data/mlbb/calibration_labels.json
MLBB_OWNER_LABELS_PATH=/root/content_bot_ml/data/mobile_legends_owner_labels.json

# --- YouTube download ---
YOUTUBE_DOWNLOAD_TIMEOUT=14400
YTDLP_SLEEP_REQUESTS=2
YTDLP_SLEEP_INTERVAL=5
YTDLP_MAX_SLEEP_INTERVAL=15

# --- PUBG VOD ranker / score gate / adaptive fight bounds ---
PUBG_RANKER_ENABLED=1
PUBG_RANKER_MODEL=/root/data/pubg/pubg_moment_ranker.joblib
PUBG_RANKER_MAX_PROBES=32
PUBG_RANKER_MIN_OOF_BALANCED_ACCURACY=0.52
PUBG_PRESEND_SCORE_MODE=1
PUBG_SCORE_REQUIRE_RANKER=1
PUBG_QUALITY_SCORE_MIN=0.48
PUBG_QUALITY_RANKER_WEIGHT=0.70
PUBG_FIGHT_SEGMENTER=1
PUBG_SEGMENT_MIN_SEC=10
PUBG_SEGMENT_MAX_SEC=28
SHOOTER_VOD_AUDIO_GENERATOR=1
SHOOTER_VOD_AUDIO_CANDIDATE_MAX=128
SHOOTER_VOD_CANDIDATE_POOL_TARGET=128

# --- Optional: YouTube OAuth (only if uploading to YouTube) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# YOUTUBE_TOKEN_FILE=/root/youtube_oauth_token.json

# --- Optional: VK (disabled in VOD-only mode) ---
# VK_MLBB_TOKEN=

# --- CPU threads (8 vCPU EU → 4; old 4 vCPU → 2) ---
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
MKL_NUM_THREADS=4
